# ==============================================================================
# GENZLOG Production Environment Configuration
# Copy this file to .env.local for local testing.
# For Vercel production deployment, configure in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HOSTED DATABASE PERSISTENCE (Choose EITHER Supabase OR Upstash Redis)
# ------------------------------------------------------------------------------

# OPTION A: Supabase (Recommended - Hosted PostgreSQL Database)
# Create a free project at https://supabase.com
# Run the following SQL in Supabase SQL Editor:
#
# CREATE TABLE inquiries (
#   id TEXT PRIMARY KEY,
#   name TEXT NOT NULL,
#   email TEXT NOT NULL,
#   company TEXT,
#   service TEXT NOT NULL,
#   budget TEXT NOT NULL,
#   timeline TEXT NOT NULL,
#   description TEXT NOT NULL,
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL,
#   user_agent TEXT,
#   ip TEXT
# );
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OPTION B: Upstash Redis (Alternative - Free Serverless Redis KV)
# Create a free database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Separate delivery mechanism via Resend)
# ------------------------------------------------------------------------------
# Create a free account at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=contact@genzlog.com
CONTACT_EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. WEBHOOK NOTIFICATIONS (Optional - Slack / Discord / Zapier)
# ------------------------------------------------------------------------------
WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. CANONICAL SITE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://genzlog.com

# ------------------------------------------------------------------------------
# 5. OFFICIAL SOCIAL MEDIA CHANNELS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/genzlog.in/?hl=en
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@genzlog17
NEXT_PUBLIC_X_URL=https://x.com/home
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/angu-hari-karthick-m-175753374/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
