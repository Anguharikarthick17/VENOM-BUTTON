# ==============================================================================
# GENZLOG Production Environment Configuration
# Copy this file to .env.local for local testing.
# For Vercel production deployment, configure in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Authentication & Storage for Free Code Admin CMS)
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# 1. Run the database migration SQL found in:
#    supabase/migrations/20261018_free_code_vault.sql
# 2. In Supabase Dashboard -> Authentication -> Users:
#    Click "Add User" -> "Create user" with your admin email and secure password.
# 3. Add your admin email to ADMIN_EMAILS below.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authorized Admin Accounts (comma-separated list of allowed email addresses)
ADMIN_EMAILS=angu@genzlog.com,admin@genzlog.com

# ------------------------------------------------------------------------------
# 2. CONTACT DESK PERSISTENCE (Inquiries Table)
# ------------------------------------------------------------------------------
# Upstash Redis (Optional alternative for contact inquiries deduplication)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (Separate delivery mechanism via Resend)
# ------------------------------------------------------------------------------
# Create a free account at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=contact@genzlog.com
CONTACT_EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 4. WEBHOOK NOTIFICATIONS (Optional - Slack / Discord / Zapier)
# ------------------------------------------------------------------------------
WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. CANONICAL SITE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://genzlog.com

# ------------------------------------------------------------------------------
# 6. OFFICIAL SOCIAL MEDIA CHANNELS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/genzlog.in/?hl=en
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@genzlog17
NEXT_PUBLIC_X_URL=https://x.com/home
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/angu-hari-karthick-m-175753374/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
